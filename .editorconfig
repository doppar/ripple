root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.php]
indent_style = space
indent_size = 4

[*.{js,mjs,cjs,css,scss}]
indent_style = space
indent_size = 2

[*.{yml,yaml,json,neon}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[composer.json]
indent_size = 4

[package.json]
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2
