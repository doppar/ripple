{
    "name": "doppar/ripple",
    "description": "Server-driven UI for Doppar with Virtual DOM delta rendering",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "doppar",
        "ripple",
        "server-driven-ui",
        "virtual-dom",
        "delta-rendering",
        "diff-engine"
    ],
    "homepage": "https://github.com/doppar/ripple",
    "authors": [
        {
            "name": "xentixar",
            "email": "xentixar@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "doppar/framework": "4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "Doppar\\Ripple\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Doppar\\Ripple\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "build": "npm run build",
        "prepublish-assets": [
            "@build"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
