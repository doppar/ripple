{
    "name": "doppar/ripple",
    "description": "Server-driven UI for Doppar with Virtual DOM delta rendering",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "doppar",
        "ripple",
        "server-driven-ui",
        "virtual-dom",
        "delta-rendering",
        "diff-engine"
    ],
    "homepage": "https://github.com/doppar/ripple",
    "authors": [
        {
            "name": "xentixar",
            "email": "xentixar@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "doppar/framework": "4.*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "Doppar\\Ripple\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Doppar\\Ripple\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G -c phpstan.neon.dist",
        "cs-check": "php-cs-fixer fix --dry-run --diff --ansi",
        "cs-fix": "php-cs-fixer fix --ansi",
        "build": "npm run build",
        "prepublish-assets": [
            "@build"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "analyse": "Run PHPStan static analysis",
        "cs-check": "Check coding style with PHP CS Fixer (dry-run)",
        "cs-fix": "Fix coding style with PHP CS Fixer",
        "build": "Build the browser client bundle"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
